{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "import",
    "unicorn",
    "oxc"
  ],
  "env": {
    "node": true,
    "vitest": true
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "./*",
              "../*"
            ],
            "message": "Use aliases @/ em vez de imports relativos para módulos internos."
          }
        ]
      }
    ]
  },
  "ignorePatterns": [
    "node_modules",
    "dist",
    "coverage"
  ]
}
