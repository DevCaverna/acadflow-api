{
  "name": "acadflow-api",
  "version": "0.1.0",
  "private": true,
  "description": "AcadFlow API - initial quality tooling scaffold",
  "scripts": {
    "lint": "oxlint --type-aware --deny-warnings src/ test/ scripts/",
    "lint:fix": "oxlint --type-aware --fix src/ test/ scripts/",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "migration:create": "node scripts/migration-create.mjs",
    "pr": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test:unit && pnpm build",
    "test": "pnpm test:unit",
    "test:unit": "vitest run --config vitest.config.unit.ts",
    "test:unit:watch": "vitest --config vitest.config.unit.ts",
    "test:integration:docker": "node scripts/run-docker-tests.mjs integration",
    "test:e2e:docker": "node scripts/run-docker-tests.mjs e2e",
    "test:docker": "node scripts/run-docker-tests.mjs all",
    "test:cov": "vitest run --config vitest.config.unit.ts --coverage",
    "build": "nest build && tsc-alias -p tsconfig.build.json",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "migration:run": "pnpm build && typeorm migration:run -d dist/database/data-source.js",
    "migration:show": "pnpm build && typeorm migration:show -d dist/database/data-source.js",
    "user:create": "pnpm build && node dist/database/cli/run-create-user.js",
    "user:create:prod": "node dist/database/cli/run-create-user.js",
    "seed": "pnpm build && node dist/database/seeds/run-seed.js",
    "migration:run:prod": "typeorm migration:run -d dist/database/data-source.js",
    "migration:revert": "pnpm build && typeorm migration:revert -d dist/database/data-source.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@aws-sdk/s3-request-presigner": "^3.1175.0",
    "@nestjs/common": "^12.6.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.6.0",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/passport": "^12.0.2",
    "@nestjs/platform-express": "^12.6.0",
    "@nestjs/swagger": "^12.1.2",
    "@nestjs/typeorm": "^12.0.3",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "nestjs-i18n": "^10.8.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "typeorm": "^1.1.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.15",
    "@nestjs/schematics": "^12.0.16",
    "@nestjs/testing": "^12.6.0",
    "@swc/core": "^1.16.22",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.1",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "supertest": "^7.3.2",
    "tsc-alias": "^1.9.10",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@12.4.2"
}
