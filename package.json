{
  "name": "acadflow-api",
  "version": "0.1.0",
  "private": true,
  "description": "AcadFlow API - initial quality tooling scaffold",
  "scripts": {
    "lint": "oxlint --type-aware --deny-warnings src/ test/ scripts/",
    "lint:fix": "oxlint --type-aware --fix src/ test/ scripts/",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "migration:create": "node scripts/migration-create.mjs",
    "pr": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test:unit && pnpm build",
    "test": "pnpm test:unit",
    "test:unit": "vitest run --config vitest.config.unit.ts",
    "test:unit:watch": "vitest --config vitest.config.unit.ts",
    "test:integration:docker": "node scripts/run-docker-tests.mjs integration",
    "test:e2e:docker": "node scripts/run-docker-tests.mjs e2e",
    "test:docker": "node scripts/run-docker-tests.mjs all",
    "test:cov": "vitest run --config vitest.config.unit.ts --coverage",
    "build": "nest build && tsc-alias -p tsconfig.build.json",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "migration:run": "pnpm build && typeorm migration:run -d dist/database/data-source.js",
    "migration:show": "pnpm build && typeorm migration:show -d dist/database/data-source.js",
    "migration:revert": "pnpm build && typeorm migration:revert -d dist/database/data-source.js"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "oxlint": "^1.88.0",
    "oxfmt": "^0.73.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "~6.0.3"
  },
  "packageManager": "pnpm@12.4.2"
}
