# Copy to .env, never commit real secrets
NODE_ENV=development
# Process time zone; the API and the database always use UTC
TZ=UTC
PORT=3000
CORS_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=acadflow
DB_PASSWORD=change-me-local-only
DB_DATABASE=acadflow
DB_SSL=false

JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
# Password of the local demo users created by pnpm seed (min 8 characters)
SEED_PASSWORD=
I18N_FALLBACK_LANGUAGE=pt-BR

# Optional profile avatar storage: leave disabled until feature is implemented
R2_ENABLED=false
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
AVATAR_MAX_BYTES=2097152
